    </Shape>
    <Shape Type="Ellipse" CutIndex="1" Rx="5" Ry="3">
        <XForm>0 1 -1 0 95 75</XForm>
    </Shape>
    <!-- A triangle with one curved side; defines the shared lists 1 and 2. -->
    <Shape Type="Path" CutIndex="1" VertID="1" PrimID="2">
        <XForm>1 0 0 1 75 50</XForm>
        <VertList>V-5 0c0x1c1x1V5 0c0x5c0y3c1x1V0 8c0x1c1x2c1y8</VertList>
        <PrimList>L0 1B1 2L2 0</PrimList>
    </Shape>
    <!-- Reuses both shared lists, 20 mm further left. -->
    <Shape Type="Path" CutIndex="1" VertID="1" PrimID="2">
        <XForm>1 0 0 1 55 50</XForm>
    </Shape>
    <Shape Type="Path" CutIndex="0" VertID="3">
        <XForm>1 0 0 1 0 0</XForm>
        <VertList>V60 100c0x1c1x1V70 100c0x1c1x1V70 110c0x1c1x1</VertList>
        <PrimList>LineClosed</PrimList>
    </Shape>
    <Shape Type="Group">
        <XForm>2 0 0 2 100 100</XForm>
        <Children>
            <Shape Type="Group">
                <XForm>1 0 0 1 5 0</XForm>
                <Children>
                    <Shape Type="Rect" CutIndex="3" W="2" H="2" Cr="0">
                        <XForm>1 0 0 1 0 0</XForm>
                    </Shape>
                    <Shape Type="Path" CutIndex="3" VertID="4" PrimID="5">
                        <XForm>1 0 0 1 0 5</XForm>
                        <VertList>V0 0c0x1c1x1V1 0c0x1c1x1</VertList>
                        <PrimList>L0 1</PrimList>
                    </Shape>
                </Children>
            </Shape>
        </Children>
    </Shape>
    <Shape Type="Text" CutIndex="0" Font="Arial,-1,100,5,50,0,0,0,0,0" Str="Hi&#10;there" H="4" LS="0" LnS="0" Ah="1" Av="1" Weld="1" HasBackupPath="1">
        <BackupPath Type="Path" CutIndex="0">
