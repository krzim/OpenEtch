    </UIPrefs>
    <CutSetting type="Scan">
        <index Value="0"/>
        <name Value="Fill"/>
        <minPower Value="12"/>
        <maxPower Value="30"/>
        <speed Value="2000"/>
        <frequency Value="100000"/>
        <QPulseWidth Value="200"/>
        <crossHatch Value="1"/>
        <interval Value="0.03"/>
        <angle Value="90"/>
        <priority Value="0"/>
        <tabCount Value="1"/>
    </CutSetting>
    <CutSetting type="Cut">
