<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written OpenEtch test fixture (not made by LightBurn). Laid out for a 150 mm field: centre (75, 75). -->
<LightBurnProject AppVersion="1.4.00" FormatVersion="1" MaterialHeight="0" MirrorX="False" MirrorY="False">
    <Thumbnail Source="iVBORw0KGgo="/>
    <VariableText>
        <Start Value="0"/>
