        "hash": "#/guide#open-the-guide"
      },
      {
        "wait": ".guide-md h2"
      },
      {
        "wait": 800
      }
    ],
    "maxWidth": 1470,
    "note": "The guide open beside the canvas on a MacBook (F1), at the start page's Open the guide section, with the Two-tone MOPA coin on the canvas."
